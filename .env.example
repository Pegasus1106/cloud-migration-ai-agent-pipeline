# Required for the LLM agents (ASU Voyager: https://voyager.rc.asu.edu/ -> LLM Access -> Create Key).
# Needs ASU Wi-Fi or the ASU SSL-VPN. Without it, run with --no-llm (rule-only mode).
ASU_RC_API_KEY=your_api_key_here

